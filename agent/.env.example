# Copy to .env, fill in SERVER_URL/AGENT_TOKEN with the values shown when
# you enrolled this agent on the server's "Agents" page (one-time — the
# token isn't shown again), then: docker compose up -d --build

SERVER_URL=wss://REPLACE_WITH_YOUR_SERVER_ADDRESS/ws/agent
AGENT_TOKEN=changeme

# Absolute HOST path that ./data (in THIS agent/ directory) resolves to
# on the machine this container runs on — required for the same reason
# as the server's own HOST_DATA_DIR (see ../.env.example): helper
# containers this agent creates via the Docker API are started by the
# HOST daemon, which only understands host paths. Get it with:
# cd agent && pwd  (then this value is that path + "/data")
HOST_DATA_DIR=/absolute/path/to/ContainerSafe/agent/data
