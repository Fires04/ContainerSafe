# --- Login (FireAuth Pattern A) ---
# Login is always required for this app (mounting the Docker socket is
# effectively root-equivalent host access) — there is no REQUIRE_LOGIN
# toggle like other apps in this family have.
APP_USERNAME=changeme
APP_PASSWORD=changeme
SESSION_SECRET=changeme
COOKIE_HTTPS_ONLY=false

# Optional Authentik OIDC — ALL FIVE (including APP_EMAIL) must be set together.
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ISSUER=https://authentik.example.lan/application/o/containersafe/
# OIDC_REDIRECT_URI=https://containersafe.example.lan/auth/callback
# APP_EMAIL=you@example.com

# --- Docker access ---
# Absolute HOST path that ./data resolves to on THIS machine (the left
# side of the "./data:/app/data" line in docker-compose.yml). REQUIRED:
# this app creates short-lived "helper" containers via the Docker API to
# move backup/restore data, and those containers are started by the HOST
# daemon, which only understands host paths — not paths inside this
# container's own filesystem. Get it with: cd ContainerSafe && pwd
# (then this value is that path + "/data").
HOST_DATA_DIR=/absolute/path/to/ContainerSafe/data

# Name of this app's own container, so discovery.py can exclude itself
# from the list of backup-able containers.
APP_CONTAINER_NAME=containersafe

# Off by default. Only enables best-effort capture of the real
# docker-compose.yml/.env text for discovered containers (read from
# /hostfs, see docker-compose.yml's commented-out host-root mount) — never
# required for actual backup/restore of container data. Two separate
# opt-ins on purpose (this + the compose mount) — see README's Security
# section.
HOSTFS_ENABLED=false

# --- Agents (server/agent multi-host model, see docs/MULTI_HOST_PLAN.md) ---
# Pepper for hashing agent enrollment tokens at rest — required as soon as
# this app runs at all (not just once you enroll an agent). Generate once
# with: openssl rand -hex 32
AGENT_TOKEN_PEPPER=changeme

# Optional — only pre-fills the SERVER_URL line of the .env snippet shown
# when enrolling a new agent (Agents page). Leave blank to fill it in by
# hand each time; set it once this server has a stable externally-facing
# address, e.g.:
# AGENT_SERVER_URL=wss://containersafe.example.lan/ws/agent
