#!/usr/bin/env bash
# ContainerSafe agent installer — generated by an /agent-install/<code>
# one-time link, consumed the moment this was fetched. Downloads the agent's
# source, writes its .env (including HOST_DATA_DIR, computed here from the
# real path on THIS host — see agent/.env.example for why that's needed),
# and starts it with `docker compose up -d --build`.
set -euo pipefail

echo "== ContainerSafe agent installer =="

command -v docker >/dev/null 2>&1 || {
  echo "docker not found — install it first: https://docs.docker.com/engine/install/" >&2
  exit 1
}
docker compose version >/dev/null 2>&1 || {
  echo "docker compose (v2 plugin) not found — this installer needs 'docker compose', not the standalone docker-compose v1" >&2
  exit 1
}

INSTALL_DIR="${DOCKERBACKUPONFIRE_AGENT_DIR:-$PWD/containersafe-agent}"
mkdir -p "$INSTALL_DIR"
cd "$INSTALL_DIR"

echo "Downloading agent source into $INSTALL_DIR ..."
curl -fsSL "__BUNDLE_URL__" -o bundle.tar.gz
tar -xzf bundle.tar.gz
rm bundle.tar.gz

mkdir -p agent/data
cat > agent/.env <<EOF
SERVER_URL=__SERVER_URL__
AGENT_TOKEN=__AGENT_TOKEN__
HOST_DATA_DIR=$INSTALL_DIR/agent/data
EOF

echo "Starting agent..."
cd agent
docker compose up -d --build

echo ""
echo "Done. Check the server's Agents page — this host should show online within a few seconds."
